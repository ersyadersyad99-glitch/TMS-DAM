# Server
PORT=3001
NODE_ENV=development

# PostgreSQL Database (matches docker-compose.yml default configuration)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/tms_db

# Better Auth secret (generate a strong random string for production)
BETTER_AUTH_SECRET=tms_super_secret_dev_key_12345
BETTER_AUTH_URL=http://localhost:3001

# CORS — frontend origin
FRONTEND_URL=http://localhost:5173

# File uploads directory (relative to backend root)
UPLOAD_DIR=uploads
