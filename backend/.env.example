# ──────────────────────────────────────────────────────────────────────────────
# TMSF Backend — Environment Variables Reference
#
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001

# REQUIRED: Set to 'production' for staging/production deployments.
# Setting this to 'production' enables CORS allowlist enforcement
# and disables the DEV_AUTH_BYPASS mechanism.
NODE_ENV=production

# ─── Database (PostgreSQL / Neon) ────────────────────────────────────────────
#
# DATABASE_URL points to the global authentication database (tms_db).
# Tenant databases (tmsf_gercepin, tmsf_dam) are derived automatically
# by replacing the database name at the end of this URL.
#
# Local PostgreSQL:
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/tms_db
#
# Neon PostgreSQL (staging — use Neon Pooler URL for runtime):
#   DATABASE_URL=postgresql://neonuser:PASSWORD@ep-xxx-pooler.neon.tech:5432/tms_db?sslmode=require
#
# Neon PostgreSQL (migrations only — use Direct URL, NOT Pooler):
#   DATABASE_URL_DIRECT=postgresql://neonuser:PASSWORD@ep-xxx.neon.tech:5432/tms_db?sslmode=require
#
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/tms_db

# Optional: Direct connection URL for running drizzle-kit migrate/push.
# Use the non-pooled Neon URL here. If not set, DATABASE_URL is used.
DATABASE_URL_DIRECT=

# Optional: Admin PostgreSQL URL used by maintenance scripts (add-pod-date, full-audit, etc.)
# If not set, scripts will fall back to DATABASE_URL.
POSTGRES_ADMIN_URL=

# ─── Tenant Connection Pool ───────────────────────────────────────────────────
# Max connections per tenant database pool.
# For Neon Free Tier: use 3–5 (total: tenants × pool_max ≤ Neon limit)
# For dedicated PostgreSQL: use 10–20
TENANT_POOL_MAX=5

# ─── Better Auth ─────────────────────────────────────────────────────────────
# REQUIRED: A strong, random secret (minimum 32 characters).
# Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_MIN_32_CHARS

# The public URL of the backend server (used by Better Auth for callbacks & cookies).
BETTER_AUTH_URL=http://localhost:3001

# ─── CORS / Frontend ─────────────────────────────────────────────────────────
# The primary frontend URL. Added to the CORS allowlist automatically.
FRONTEND_URL=http://localhost:5173

# Optional: Comma-separated list of additional allowed origins.
# Example for staging + dam subdomain:
#   CORS_ORIGINS=https://tms-staging.digitalinaja.net,https://dam.digitalinaja.net
CORS_ORIGINS=

# ─── File Uploads ─────────────────────────────────────────────────────────────
# Directory (relative to backend/) where uploaded files are stored.
# On Render / Railway: use a mount path for a persistent disk, e.g. /opt/render/project/uploads
# For Vercel: file uploads are NOT supported (use S3/R2 instead — see docs).
UPLOAD_DIR=uploads

# ─── Development Only — Auth Bypass ──────────────────────────────────────────
# DEV_AUTH_BYPASS allows skipping Better Auth session validation for local development.
#
# WARNING: NEVER set DEV_AUTH_BYPASS=true in staging or production.
#          The bypass is hard-blocked when NODE_ENV=production.
#
# To use: set both variables AND ensure NODE_ENV is NOT 'production'.
#   DEV_AUTH_BYPASS=true
#   DEV_AUTH_USER=admin@example.com   (must be an existing, active user in tms_db)
#
DEV_AUTH_BYPASS=false
DEV_AUTH_USER=
